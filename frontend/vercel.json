{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/app/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://onam-backend.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://onam-backend.onrender.com/uploads/:path*" }
  ]
}
