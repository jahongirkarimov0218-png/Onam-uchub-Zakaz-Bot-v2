# Onam Shop — namuna sozlamalar fayli. Nusxasini .env deb saqlang va qiymatlarni to'ldiring.
# Bu faylni hech qachon haqiqiy tokenlar bilan commit qilmang — faqat .env.example commit qilinadi.

# Mijozlar boti tokeni (BotFather'dan)
CUSTOMER_BOT_TOKEN=

# Admin boti tokeni (BotFather'dan)
ADMIN_BOT_TOKEN=

# Admin Telegram id'lari, vergul bilan ajratilgan (masalan: 111111111,222222222)
ADMIN_IDS=

# Botlarni yoqish/o'chirish. false yoki tokenlar bo'sh bo'lsa — API botlarsiz ishga tushadi
BOTS_ENABLED=true

# Mini App joylashgan asosiy URL (masalan: https://example.com)
WEBAPP_URL=

# Telegram Bot API manzili (bo'sh — rasmiy Telegram; E2E uchun local mock server)
TELEGRAM_API_BASE=

# Do'kon nomi (botlar va Mini App'da ko'rsatiladi)
SHOP_NAME=Faberlik Sotuv Bot

# Olib ketish manzili (pickup)
PICKUP_ADDRESS=

# Ma'lumotlar bazasi manzili (SQLite, backend papkasiga nisbatan)
DATABASE_URL=sqlite+aiosqlite:///./data/onam.db

# Yuklangan fayllar papkasi
UPLOAD_DIR=uploads

# Frontend build chiqishi (Vite dist papkasi)
FRONTEND_DIST=../frontend/dist

# initData qancha vaqt amal qiladi (sekundlarda)
INIT_DATA_MAX_AGE_SECONDS=86400

# Zakaz "yangi" holatida necha soatdan keyin birinchi eslatma yuboriladi
REMINDER_FIRST_HOURS=2

# Keyingi eslatmalar necha soatda bir marta takrorlanadi
REMINDER_REPEAT_HOURS=4

# Eslatma job'i necha daqiqada bir tekshiradi
REMINDER_CHECK_MINUTES=5

# Kunlik hisobot yuboriladigan vaqt (HH:MM)
DAILY_REPORT_TIME=09:00

# Vaqt zonasi
TIMEZONE=Asia/Tashkent

# Bitta foydalanuvchi uchun zakaz limiti (RATE_LIMIT_WINDOW_SECONDS ichida)
RATE_LIMIT_ORDERS=5

# Bitta foydalanuvchi uchun fayl yuklash limiti (RATE_LIMIT_WINDOW_SECONDS ichida)
RATE_LIMIT_UPLOADS=10

# Rate limit oynasi (sekundlarda)
RATE_LIMIT_WINDOW_SECONDS=600

# Yuklanadigan faylning maksimal hajmi (MB)
MAX_UPLOAD_MB=5

# Domen nomi (Caddy uchun)
DOMAIN=
